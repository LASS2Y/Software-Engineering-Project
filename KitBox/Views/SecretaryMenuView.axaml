<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KitBox.Views.SecretaryMenuView"
             xmlns:vm="clr-namespace:KitBox.ViewModels"
             x:DataType="vm:SecretaryMenuViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/AppDefaultStyle.axaml"/>
    </UserControl.Styles>

    <Grid Background="#F5F7FA">
        <Border Background="White"
                Width="800"
                Height="600"
                CornerRadius="35"
                BorderThickness="0.5"
                BorderBrush="Black">

            <Grid RowDefinitions="Auto,*,Auto"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <!-- Back button -->
                <Button HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="-350,-220,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding BackCommand}">
                    <TextBlock Text="← Back" FontSize="16" Foreground="#7C3AED"/>
                </Button>

                <!-- Title -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,60">
                    <TextBlock Text="Secretary"
                               FontSize="52"
                               FontStyle="Italic"
                               FontWeight="Bold"
                               Foreground="#7C3AED"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose your workspace"
                               FontSize="16"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Two option buttons -->
                <StackPanel Grid.Row="1" Spacing="20">

                    <!-- Supplier Catalog -->
                    <Button Width="750"
                            Height="100"
                            Background="#7C3AED"
                            BorderThickness="0.5"
                            BorderBrush="Black"
                            CornerRadius="50"
                            Command="{Binding GoToSupplierCatalogCommand}"
                            Classes="StartPageButton">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <TextBlock Text=""
                                       FontSize="28"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Supplier Catalog"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="DemiBold"
                                           FontStyle="Italic"/>
                                <TextBlock Text="Update prices and delivery times"
                                           Foreground="#DDD6FE"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Stock Management -->
                    <Button Width="750"
                            Height="100"
                            Background="#374151"
                            BorderThickness="0.5"
                            BorderBrush="Black"
                            CornerRadius="50"
                            Command="{Binding GoToStockManagementCommand}"
                            Classes="StartPageButton">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <TextBlock Text=""
                                       FontSize="28"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Stock Management"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="DemiBold"
                                           FontStyle="Italic"/>
                                <TextBlock Text="View inventory and update quantities"
                                           Foreground="#D1D5DB"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Order History -->
                    <Button Width="750"
                            Height="100"
                            Background="#0F766E"
                            BorderThickness="0.5"
                            BorderBrush="Black"
                            CornerRadius="50"
                            Command="{Binding GoToOrderHistoryCommand}"
                            Classes="StartPageButton">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12">
                            <TextBlock Text=""
                                       FontSize="28"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Order History"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="DemiBold"
                                           FontStyle="Italic"/>
                                <TextBlock Text="Track orders, deliveries and invoices"
                                           Foreground="#99F6E4"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
