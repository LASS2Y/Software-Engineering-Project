<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KitBox.Views.EmployeeInscriptionView"
             xmlns:vm="clr-namespace:KitBox.ViewModels"
             x:DataType="vm:EmployeeInscriptionViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/AppDefaultStyle.axaml"/>
    </UserControl.Styles>
    <Grid Background="#F5F7FA" RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Background="#4F46E5" Padding="24" CornerRadius="0,0,24,24">
        <Grid ColumnDefinitions="Auto,*">
           

            <TextBlock Grid.Column="1"
                       Text="Register Employee"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>

    <!-- Register Card -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Hidden"
                  Margin="0">
    <Border Grid.Row="1"
            Background="White"
            MaxWidth="540"
            Margin="0,40,0,0"
            Padding="40"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            BoxShadow="0 4 24 0 #1A000000">

        <StackPanel Spacing="20">

            <StackPanel Spacing="6">
                <TextBlock Text="Create a new employee account"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Fill in the employee information below."
                           FontSize="15"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- First name -->
            <StackPanel Spacing="6">
                <TextBlock Text="First Name *"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding FirstName}"
                         Watermark="John"
                         CornerRadius="10"/>
            </StackPanel>

            <!-- Last name -->
            <StackPanel Spacing="6">
                <TextBlock Text="Last Name *"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding LastName }"
                         Watermark="Smith"
                         CornerRadius="10"/>
            </StackPanel>

            <!-- Email -->
            <StackPanel Spacing="6">
                <TextBlock Text="Email Address *"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Email}"
                         Watermark="john.smith@kitbox.com"
                         CornerRadius="10"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="6">
                <TextBlock Text="Password *"
                           FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="PasswordBox"
                             Grid.Column="0"
                             Text="{Binding Password}"
                             Watermark="Enter a password"
                             PasswordChar="●"
                             CornerRadius="10"/>
                    <ToggleButton Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Content="Show"
                                  IsChecked="{Binding #PasswordBox.RevealPassword}"
                                  VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Confirm password -->
            <StackPanel Spacing="6">
                <TextBlock Text="Confirm Password *"
                           FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="ConfirmPasswordBox"
                             Grid.Column="0"
                             Text="{Binding ConfirmPassword }"
                             Watermark="Repeat the password"
                             PasswordChar="●"
                             CornerRadius="10"/>
                    <ToggleButton Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Content="Show"
                                  IsChecked="{Binding #ConfirmPasswordBox.RevealPassword}"
                                  VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Validation error -->
            <Border IsVisible="{Binding  Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#FEE2E2"
                    CornerRadius="8"
                    Padding="12">
                <TextBlock Text="{Binding ErrorMessage }"
                           Foreground="#DC2626"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Register button -->
            <Button HorizontalAlignment="Stretch"
                    Height="52"
                    Background="#4F46E5"
                    Foreground="White"
                    CornerRadius="12"
                    FontSize="16"
                    FontWeight="Bold"
                    Command="{Binding RegisterEmployeeCommand }"
                    Classes="StartPageButton">
                <TextBlock Text="Register →"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- Separator -->
            <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
                <Separator Grid.Column="0" Background="#E2E8F0"/>
                <TextBlock Grid.Column="1"
                           Text="or"
                           Foreground="#94A3B8"
                           FontSize="13"
                           Margin="12,0"
                           VerticalAlignment="Center"/>
                <Separator Grid.Column="2" Background="#E2E8F0"/>
            </Grid>

            <!-- Cancel button -->
            <Button HorizontalAlignment="Stretch"
                    Height="52"
                    Background="Transparent"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    FontSize="15"
                    Foreground="#475569"
                    Command="{Binding CancelCommand}"
                    Classes="StartPageButton">
                <TextBlock Text="Cancel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

        </StackPanel>
    </Border>
    </ScrollViewer>
</Grid>
</UserControl>    