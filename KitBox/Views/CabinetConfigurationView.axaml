<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="KitBox.Views.CabinetConfigurationView"
             xmlns:vm="clr-namespace:KitBox.ViewModels"
             x:DataType="vm:CabinetConfigurationViewModel">

    <UserControl.Styles>
        <StyleInclude Source="/Styles/AppDefaultStyle.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#F5F7FA">

        <!-- Header -->
        <Border Background="#4F46E5" Padding="20,16" CornerRadius="0,0,20,20">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Background="Transparent" BorderThickness="0"
                        Command="{Binding BackCommand}"
                        Classes="BackButton">
                    <TextBlock Text="← Back" Foreground="White" FontSize="15"/>
                </Button>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Cabinet Configuration"
                               FontSize="22" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CustomerName, StringFormat='Customer: {0}'}"
                               Foreground="#C7D2FE" FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding LockerCount, StringFormat='{}{0}/7 lockers'}"
                           Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
            </Grid>
        </Border>

        <!-- Locker list -->
        <ScrollViewer Grid.Row="1" Margin="24,16">
            <StackPanel Spacing="12">

                <!-- Locker rows -->
                <ItemsControl ItemsSource="{Binding Lockers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LockerConfigViewModel">
                            <Border Background="White" CornerRadius="14"
                                    Padding="16" Margin="0,0,0,8"
                                    BoxShadow="0 2 10 0 #12000000">
                                <Grid ColumnDefinitions="*,*,*,*,*,*,Auto" ColumnSpacing="12">

                                    <!-- Height -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Height (cm)" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding AvailableHeights}"
                                                  SelectedItem="{Binding Height}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Width -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Width (cm)" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding AvailableWidths}"
                                                  SelectedItem="{Binding Width}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Depth -->
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Depth (cm)" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding AvailableDepths}"
                                                  SelectedItem="{Binding Depth}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Color -->
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="Color" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding AvailableColors}"
                                                  SelectedItem="{Binding Color}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Has Doors -->
                                    <StackPanel Grid.Column="4" Spacing="4"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Doors?" FontSize="12" Foreground="#64748B"
                                                   HorizontalAlignment="Center"/>
                                        <CheckBox IsChecked="{Binding HasDoors}"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Door Color -->
                                    <StackPanel Grid.Column="5" Spacing="4"
                                                IsVisible="{Binding HasDoors}">
                                        <TextBlock Text="Door Color" FontSize="12" Foreground="#64748B"/>
                                        <ComboBox ItemsSource="{Binding AvailableDoorColors}"
                                                  SelectedItem="{Binding DoorColor}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add locker button -->
                <Button HorizontalAlignment="Left"
                        Command="{Binding AddLockerCommand}"
                        Background="Transparent"
                        BorderBrush="#4F46E5"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="16,8"
                        Foreground="#4F46E5"
                        Content="+ Add Locker"/>

                <!-- Angle iron color -->
                <Border Background="White" CornerRadius="14"
                        Padding="16" BoxShadow="0 2 10 0 #12000000">
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                VerticalAlignment="Center">
                        <TextBlock Text="Angle iron color:"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AngleIronColors}"
                                  SelectedItem="{Binding AngleIronColor}"
                                  Width="160"/>
                    </StackPanel>
                </Border>

                <!-- Validation error -->
                <Border IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#FEF3C7" CornerRadius="10" Padding="14">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#92400E"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="24,16"
                BoxShadow="0 -2 12 0 #0F000000">
            <Button HorizontalAlignment="Right"
                    Height="50"
                    Width="200"
                    Background="#4F46E5"
                    Foreground="White"
                    CornerRadius="12"
                    FontSize="16"
                    FontWeight="Bold"
                    Command="{Binding ProceedCommand}"
                    Classes="StartPageButton">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    Preview Order →
                </TextBlock>
            </Button>
        </Border>
    </Grid>
</UserControl>
