<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KitBox.Views.DashBoardView"
             xmlns:vm="clr-namespace:KitBox.ViewModels"
             x:DataType="vm:DashBoardViewModel">
  
    
    <UserControl.Styles>
        <StyleInclude Source="/Styles/AppDefaultStyle.axaml"/>
    </UserControl.Styles>
    
       <Grid Background="#F8FAFC" RowDefinitions="Auto,*" 
             RowSpacing="24">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#6366F1" Height="80" CornerRadius="16" Margin="0,0,0,24">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Margin="32,0">
                    <TextBlock Text="📊 Application Metrics" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding TimeRange}" Margin="0,8,0,0" Width="120">
                        <ComboBoxItem Content="Day"/>
                        <ComboBoxItem Content="Week"/>
                        <ComboBoxItem Content="Month"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Refresh" Command="{Binding }" 
                        Background="Transparent" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Main Grid 2x2 -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*" RowDefinitions="1,1" ColumnSpacing="24" RowSpacing="24">
            
            <!-- Metrics Cards (Colonne 1) -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
                
                <!-- Total Users -->
                <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Total Users" FontSize="14" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding TotalUsersTrend}" FontSize="14" Foreground="#10B981"/>
                    </StackPanel>
                </Border>

                <!-- New Users -->
                <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="New Users" FontSize="14" Foreground="#64748B"/>
                        <TextBlock Text="{Binding NewUsers}" FontSize="36" FontWeight="Bold"/>
                       <!-- <ProgressBar Value="{Binding NewUsersTrend}" Maximum="100" Height="8" Background="#E2E8F0" Foreground="#3B82F6"/> -->
                    </StackPanel>
                </Border>

                <!-- Bounce Sessions -->
                <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bounce Sessions" FontSize="14" Foreground="#64748B"/>
                        <TextBlock Text="{Binding BounceRate }"/>
                    </StackPanel>
                </Border>

                <!-- Graphiques -->
                <Border Grid.Row="3" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📈 User Behavior Analysis" FontSize="18" FontWeight="Bold"/>
                        
                        <Canvas Width="400" Height="200" Background="#F1F5F9" >
                            <!--Graphique ligne (simulé) -->
                            <Rectangle Width="400" Height="2" Fill="#E2E8F0" Canvas.Top="100"/>
                            <Rectangle Width="20" Height="80" Fill="#3B82F6" Canvas.Left="50" Canvas.Top="20"/>
                            <Rectangle Width="20" Height="120" Fill="#3B82F6" Canvas.Left="150" Canvas.Top="-20"/>
                            <Rectangle Width="20" Height="100" Fill="#3B82F6" Canvas.Left="250" Canvas.Top="0"/>
                        </Canvas>
                         
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Droite : Activity + App Downloads -->
            <Grid Grid.Column="1" RowDefinitions="1,1" RowSpacing="24">
                
                <!-- Activity MAU -->
                <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="16">
                        <TextBlock Text="👥 Activity MAU" FontSize="18" FontWeight="Bold"/>
                                               
                         <Canvas Width="300" Height="200" Background="#F1F5F9" >
                            <!-- Barres -->
                            <Rectangle Width="40" Height="120" Fill="#10B981" Canvas.Left="20" Canvas.Top="80"/>
                            <Rectangle Width="40" Height="160" Fill="#10B981" Canvas.Left="80" Canvas.Top="40"/>
                            <Rectangle Width="40" Height="140" Fill="#10B981" Canvas.Left="140" Canvas.Top="60"/>
                            <Rectangle Width="40" Height="180" Fill="#10B981" Canvas.Left="200" Canvas.Top="20"/>
                        </Canvas>
                        
                        <TextBlock Text="📱 App Downloads" FontSize="18" FontWeight="Bold"/>
                        <Canvas Width="300" Height="200" Background="#F1F5F9">
                            <!--Graphique circulaire simulé-->
                            <Ellipse Width="120" Height="120" Fill="#F59E0B" Canvas.Left="90" Canvas.Top="40"/>
                            <Ellipse Width="80" Height="80" Fill="White" Canvas.Left="110" Canvas.Top="60"/>
                            <TextBlock Text="55%" FontSize="24" FontWeight="Bold" 
                                       Canvas.Left="140" Canvas.Top="85" Foreground="#F59E0B"/>
                            <TextBlock Text="App Store 55% | Google Play 45%" FontSize="12" 
                                       Canvas.Left="110" Canvas.Top="150" Foreground="#64748B"/>
                        </Canvas>
                    </StackPanel>
                    
                </Border>

                <!-- App Downloads -->
                <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="24" BoxShadow="0 4 12 0 #1A000000">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📱 App Downloads" FontSize="18" FontWeight="Bold"/>
                        
                       
                        
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>