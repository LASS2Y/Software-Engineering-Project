<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Add Styles Here -->
    <Style Selector="Grid.MenuBar">
        <Setter Property="Height" Value="125"></Setter>
        <Setter Property="Background" Value="Blue"></Setter>
    </Style>
    
    <Style Selector="Button.FirstTopic">
        <Setter Property="BorderThickness" Value="0.5"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="Background" Value="White"></Setter>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Width" Value="450"></Setter>
        <Setter Property="Height" Value="500"></Setter>
    </Style>
    
    <Style Selector="Button.FirstTopic /template/ ContentPresenter">
        <Setter Property="Foreground" Value="Black"></Setter>
    </Style>
    
    <Style Selector="Label.icon">
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="FontFamily" Value="{DynamicResource Phosphor}"></Setter>
        <Setter Property="FontSize" Value="36"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
    </Style>
    
    <Style Selector="Button.nav-button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="40"/>
    </Style>
    
    <Style Selector="Border.trending">
        <Setter Property="BorderThickness" Value="0.5"></Setter>
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Height" Value="500"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BoxShadow" Value="0 4 12 #20000000"/>
    </Style>
    
    <Style Selector="Button.StartPageButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#303030"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
    </Style>
    
    <Style Selector="Button.BackButton">
        <Setter Property="RenderTransform" Value="scale(1)"></Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.5"></BrushTransition>
                <BrushTransition Property="Foreground" Duration="0:0:0.5"></BrushTransition>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5"></TransformOperationsTransition>
            </Transitions>
        </Setter>
    </Style>
    
    <Style Selector="Button.BackButton:pointerover /template/ ContentPresenter">
        <Setter Property="RenderTransform" Value="scale(1.15)"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    
    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Width" Value="120"/> 
    </Style>
    
    <Style Selector="Button.MainButton:pointerover">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    
    <Style Selector="Button.MainButton:pressed">
        <Setter Property="Background" Value="White"/>
    </Style>
    
    <Style Selector="Button.StartPageButtonAdmin /template/ ContentPresenter">
        <Setter Property="FontFamily" Value="{DynamicResource PhosphorFill}"></Setter>
        <Setter Property="FontSize" Value="26"></Setter>
    </Style>
    
    <Style Selector="Button.StartPageButtonAdmin:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#303030"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
    </Style>
    
    <Style Selector="Label.akko">
        <Setter Property="FontFamily" Value="{DynamicResource AkkoPro}"></Setter>
        
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    
    <Style Selector=" Button.NavButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4F46E5"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
    </Style>
    
    <Style Selector="Label.iconMenu">
        <Setter Property="FontFamily" Value="{DynamicResource PhosphorFill}"></Setter>
        <Setter Property="FontSize" Value="26"></Setter>
        <Setter Property="Padding" Value="0 2.5 -0.4 3"></Setter>
        <Setter Property="Margin" Value="0 0 5 0"></Setter>
    </Style>
    
    <Style Selector="Button.NavButton">
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>
    
    <Style Selector="Button.NavButton /template/ ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>
    
    <Style Selector="Button.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundGradient}"></Setter>
    </Style>
    
    <!-- Couleurs génériques -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="LightGray"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Carte de graphique (zone intérieure du graph) -->
    <Style Selector="Border.card-chart">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#334155"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- Texte des titres dans les cartes -->
    <Style Selector="Border.card > StackPanel > TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- Texte de valeur des KPI -->
    <Style Selector="Border.card > StackPanel > TextBlock:nth-child(2)">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Style général du Dashboard (Grid, texte titre) -->
    <Style Selector="Grid#DashboardRoot">
        <Setter Property="Background" Value="#F8FAFC"/>
    </Style>

    <Style Selector="Grid#DashboardRoot > TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="16,0,16,16"/>
    </Style>
    
</Styles>
